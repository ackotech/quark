{
  "name": "@quark-hq/quark",
  "version": "0.0.3",
  "description": "Quark CLI — workspace scaffolding, package creation, and Yalc workflows for design-system monorepos",
  "keywords": [
    "quark",
    "cli",
    "monorepo",
    "scaffold",
    "design-system",
    "typescript",
    "pnpm",
    "nx"
  ],
  "homepage": "https://github.com/ackotech/quark#readme",
  "bugs": {
    "url": "https://github.com/ackotech/quark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackotech/quark.git",
    "directory": "cli/quark-cli"
  },
  "license": "MIT",
  "author": "Acko Technologies",
  "main": "dist/index.js",
  "bin": {
    "quark": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "src/templates/github/workflows"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @quark-hq/quark-security run build && node scripts/generate-atlas-manifest.mjs",
    "generate-atlas-manifest": "pnpm --filter @quark-hq/quark-security run build && node scripts/generate-atlas-manifest.mjs",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "npm run build && node dist/index.js",
    "test": "jest --watch",
    "coverage": "jest --ci --coverage"
  },
  "dependencies": {
    "@quark-hq/quark-scripts": "workspace:*",
    "@quark-hq/quark-security": "workspace:*",
    "@types/chalk": "^2.2.4",
    "@types/commander": "^2.12.5",
    "@types/ejs": "^3.1.5",
    "@types/node": "25.0.9",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "ejs": "^3.1.10",
    "ts-dedent": "^2.2.0",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
