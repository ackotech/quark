{
  "name": "@quark-hq/quark-scripts",
  "version": "0.0.1",
  "description": "Quark release automation — version bumps, dev/prod publish, and monorepo release orchestration",
  "keywords": [
    "quark",
    "cli",
    "release",
    "publish",
    "monorepo",
    "nx",
    "semver",
    "typescript"
  ],
  "homepage": "https://github.com/ackotech/quark#readme",
  "bugs": {
    "url": "https://github.com/ackotech/quark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackotech/quark.git",
    "directory": "cli/quark-scripts"
  },
  "license": "MIT",
  "author": "Acko Technologies",
  "main": "dist/index.js",
  "bin": {
    "quark-scripts": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "start": "npm run build && node dist/index.js",
    "test": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@quark-hq/quark-security": "workspace:*",
    "@nx/devkit": "22.1.3",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "prompts": "^2.4.2",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "25.0.9",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.0",
    "jest": "^30.2.0",
    "jest-mock": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2"
  }
}
